<?xml version="1.0" encoding="utf-8"?>
<!-- Single-row strip variant (1x4): disc + title/lyric + compact transport -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="4dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_player_disc"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Album art"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="Nothing Lyrics"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_lyric_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="Play music to see lyrics"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_player_prev"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="Previous"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_prev" />

    <ImageButton
        android:id="@+id/widget_player_play_pause"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_button_primary"
        android:contentDescription="Play or pause"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_play" />

    <ImageButton
        android:id="@+id/widget_player_next"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="Next"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_next" />

</LinearLayout>
